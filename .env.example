# Copia este archivo a ".env" y completa los valores. ".env" esta en .gitignore: no lo subas.
# Todos los valores de abajo son de ejemplo; genera los tuyos.

NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=taskapp
# Genera una contrasena propia, por ejemplo: openssl rand -base64 24
DB_PASSWORD=
DB_NAME=taskdb
# true crea las tablas automaticamente (desarrollo/demo). En produccion usa migraciones.
DB_SYNCHRONIZE=true

# Firma de los JWT: minimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Origen permitido por CORS (opcional; si se omite, CORS queda desactivado)
# CORS_ORIGIN=https://krin2.github.io

# Admin inicial (opcional, se definen juntos; la contrasena debe tener 12+ caracteres)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
